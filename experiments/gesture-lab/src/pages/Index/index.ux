  width: 100%;
  height: 100%;
  flex-direction: column;
  padding: 10px;
  background-color: #0a0a0c;
}

.h1 {
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 2px;
}

.sub {
  color: #9aa0a6;
  margin-bottom: 6px;
}

.card {
  width: 100%;
  flex-direction: column;
  padding: 6px 10px;
  border-radius: 10px;
  border-width: 1px;
  border-color: #26262b;
  background-color: #141418;
  margin-bottom: 8px;
}

.kv {
  width: 100%;
  height: 24px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.k {
  color: #a8adb3;
}

.v {
  color: #6ee7a8;
  font-weight: bold;
}

.btn {
  width: 100%;
  height: 56px;
  border-radius: 12px;
  background-color: #1f6feb;
  justify-content: center;
  align-items: center;
  margin-bottom: 8px;
}

.btn-t {
  color: #ffffff;
  font-weight: bold;
}

.logbar {
  width: 100%;
  height: 24px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4px;
}

.mini {
  height: 22px;
  padding-left: 10px;
  padding-right: 10px;
  border-radius: 6px;
  background-color: #26262b;
  justify-content: center;
  align-items: center;
}

.mini-t {
  color: #ffffff;
}

.logbox {
  width: 100%;
  flex: 1;
}

.log {
  color: #d0d4d8;
  margin-bottom: 2px;
}
</style>
